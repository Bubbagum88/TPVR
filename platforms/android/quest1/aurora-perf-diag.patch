diff --git a/lib/gx/perf_diag.cpp b/lib/gx/perf_diag.cpp
new file mode 100644
index 0000000..a5df7a2
--- /dev/null
+++ b/lib/gx/perf_diag.cpp
@@ -0,0 +1,282 @@
+#include "perf_diag.hpp"
+
+#include "../gfx/recording.hpp"
+#include "../internal.hpp"
+#include "gx.hpp"
+#include "pipeline.hpp"
+#include "../gfx/texture.hpp"
+
+#include <absl/container/flat_hash_map.h>
+#include <absl/container/flat_hash_set.h>
+
+#include <algorithm>
+#include <cstring>
+#include <atomic>
+#include <string>
+#include <vector>
+
+namespace aurora::perf_diag {
+namespace {
+constexpr Module Log{"aurora::perf_diag"};
+
+// Frames per summary, and the frame (of each window) whose eye pass is split.
+constexpr uint32_t WindowFrames = 120;
+constexpr uint32_t SplitFrameInWindow = 60;
+// gpu_prof times at most 127 passes a frame; keep the splits well inside that.
+constexpr uint32_t MaxSplitsPerFrame = 90;
+
+constexpr const char* NoGroup = "(no list)";
+constexpr const char* BetweenGroups = "(between lists)";
+
+struct Key {
+  const char* name;
+  uint32_t width;
+  uint32_t height;
+
+  bool operator==(const Key&) const = default;
+  template <typename H>
+  friend H AbslHashValue(H h, const Key& k) {
+    return H::combine(std::move(h), k.name, k.width, k.height);
+  }
+};
+
+struct Stats {
+  uint64_t draws = 0;
+  uint64_t mergedDraws = 0;
+  uint64_t verts = 0;
+  uint64_t indices = 0;
+  uint64_t blend = 0;
+  uint64_t alphaTest = 0;
+  uint64_t noDepthWrite = 0;
+  uint64_t noDepthTest = 0;
+  uint64_t fog = 0;
+  uint64_t ortho = 0;
+  uint64_t lines = 0;
+  uint64_t stereo = 0;
+  uint64_t tevStages = 0;
+  uint32_t tevMax = 0;
+  uint64_t indDraws = 0;
+  uint64_t lit = 0;
+  uint64_t textures = 0;
+  uint64_t texels = 0;
+  uint64_t copyReads = 0;
+  uint64_t aniso2 = 0; // textures the game asked to filter at GX_ANISO_2
+  uint64_t aniso4 = 0; // ... at GX_ANISO_4
+  absl::flat_hash_set<uint64_t> pipelines;
+};
+
+// FIFO thread state.
+std::vector<const char*> sGroupStack;
+absl::flat_hash_map<Key, Stats> sStats;
+Stats* sLastStats = nullptr; // target of on_merged_draw
+bool sSplitFrame = false;
+uint32_t sSplitsThisFrame = 0;
+uint32_t sDrawInGroup = 0; // draws so far in the innermost list (per-draw split labels)
+
+// Frame-boundary state.
+uint32_t sFrames = 0;
+uint64_t sFrameCounter = 0;
+std::atomic<uint64_t> sFifoNs{0};
+
+std::string filtering_name() {
+  const uint16_t aniso = gfx::max_texture_anisotropy();
+  return aniso <= 1 ? std::string("off") : fmt::format("{}x", aniso);
+}
+uint64_t sVertBytes = 0;
+uint64_t sUniformBytes = 0;
+uint64_t sIndexBytes = 0;
+uint64_t sStorageBytes = 0;
+uint64_t sTextureUploadBytes = 0;
+uint64_t sDrawCalls = 0;
+uint64_t sMergedDrawCalls = 0;
+uint64_t sRenderPasses = 0;
+
+// Draw stats go to the innermost list; eye-pass splits happen at top-level lists only.
+const char* current_group() noexcept { return sGroupStack.empty() ? NoGroup : sGroupStack.back(); }
+
+void split(const char* name) noexcept {
+  if (!sSplitFrame || sSplitsThisFrame >= MaxSplitsPerFrame) {
+    return;
+  }
+  if (gfx::perf_split_pass(name)) {
+    ++sSplitsThisFrame;
+  }
+}
+
+double per_frame(uint64_t v) noexcept { return static_cast<double>(v) / static_cast<double>(sFrames); }
+
+void log_summary() noexcept {
+  Log.info("[perfdiag] {} frames, anisotropic filtering {}: engine per frame: GX FIFO processing {:.2f} ms | draws {:.0f} (+{:.0f} merged) | "
+           "render passes {:.1f} | uploads: verts {:.0f} KB, uniforms {:.0f} KB, indices {:.0f} KB, storage {:.0f} KB, "
+           "textures {:.0f} KB",
+           sFrames, filtering_name(), per_frame(sFifoNs.exchange(0, std::memory_order_relaxed)) * 1e-6, per_frame(sDrawCalls),
+           per_frame(sMergedDrawCalls), per_frame(sRenderPasses), per_frame(sVertBytes) / 1024.0,
+           per_frame(sUniformBytes) / 1024.0, per_frame(sIndexBytes) / 1024.0, per_frame(sStorageBytes) / 1024.0,
+           per_frame(sTextureUploadBytes) / 1024.0);
+
+  std::vector<std::pair<const Key*, const Stats*>> rows;
+  rows.reserve(sStats.size());
+  for (const auto& [key, stats] : sStats) {
+    rows.emplace_back(&key, &stats);
+  }
+  std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+    return a.second->draws + a.second->mergedDraws > b.second->draws + b.second->mergedDraws;
+  });
+  for (const auto& [key, s] : rows) {
+    const double draws = per_frame(s->draws);
+    Log.info("[perfdiag] list {} @{}x{}: draws {:.1f} (+{:.1f} merged), verts {:.0f}, indices {:.0f} | "
+             "blend {:.1f}, alpha test {:.1f}, no depth write {:.1f}, no depth test {:.1f}, fog {:.1f}, "
+             "screen-space {:.1f}, lines/points {:.1f}, stereo {:.1f}, lit {:.1f} | TEV stages avg {:.1f} max {}, "
+             "indirect {:.1f} | textures {:.1f} (game asks aniso 2x {:.1f}, 4x {:.1f}), texels {:.0f}K, "
+             "screen-copy reads {:.1f} | pipelines {}",
+             key->name, key->width, key->height, draws, per_frame(s->mergedDraws), per_frame(s->verts),
+             per_frame(s->indices), per_frame(s->blend), per_frame(s->alphaTest), per_frame(s->noDepthWrite),
+             per_frame(s->noDepthTest), per_frame(s->fog), per_frame(s->ortho), per_frame(s->lines),
+             per_frame(s->stereo), per_frame(s->lit),
+             s->draws != 0 ? static_cast<double>(s->tevStages) / static_cast<double>(s->draws) : 0.0, s->tevMax,
+             per_frame(s->indDraws), per_frame(s->textures), per_frame(s->aniso2), per_frame(s->aniso4),
+             per_frame(s->texels) / 1000.0,
+             per_frame(s->copyReads), s->pipelines.size());
+  }
+}
+} // namespace
+
+void group_push(const char* name) noexcept {
+  if (name == nullptr) {
+    name = "(unnamed)";
+  }
+  sGroupStack.push_back(name);
+  sDrawInGroup = 0;
+  if (sGroupStack.size() == 1) {
+    split(name);
+  }
+}
+
+void group_pop() noexcept {
+  if (sGroupStack.empty()) {
+    Log.warn("[perfdiag] list pop with no list open");
+    return;
+  }
+  sGroupStack.pop_back();
+  if (sGroupStack.empty()) {
+    split(BetweenGroups);
+  }
+}
+
+void on_gx_draw(const gx::PipelineConfig& config, const gx::ShaderInfo& info, uint64_t pipeline, uint32_t vtxCount,
+                uint32_t indexCount, uint32_t instanceCount) noexcept {
+  const auto size = gfx::get_render_target_size();
+  auto& s = sStats[Key{current_group(), size.x, size.y}];
+  sLastStats = &s;
+  const auto& shader = config.shaderConfig;
+  ++s.draws;
+  s.verts += static_cast<uint64_t>(vtxCount) * instanceCount;
+  s.indices += indexCount;
+  s.blend += config.blendMode != GX_BM_NONE ? 1 : 0;
+  s.alphaTest += shader.alphaCompare ? 1 : 0;
+  s.noDepthWrite += config.depthUpdate ? 0 : 1;
+  s.noDepthTest += config.depthCompare ? 0 : 1;
+  s.fog += info.usesFog ? 1 : 0;
+  s.ortho += gx::g_gxState.projType == GX_ORTHOGRAPHIC ? 1 : 0;
+  s.lines += info.lineMode != 0 ? 1 : 0;
+  s.stereo += info.stereo ? 1 : 0;
+  s.lit += info.lightingEnabled ? 1 : 0;
+  s.tevStages += shader.tevStageCount;
+  s.tevMax = std::max(s.tevMax, shader.tevStageCount);
+  s.indDraws += info.usedIndStages.any() ? 1 : 0;
+  for (uint32_t i = 0; i < gx::MaxTextures; ++i) {
+    if (!info.sampledTextures.test(i)) {
+      continue;
+    }
+    const auto& tex = gx::g_gxState.loadedTextures[i];
+    ++s.textures;
+    s.aniso2 += tex.max_aniso() == GX_ANISO_2 ? 1 : 0;
+    s.aniso4 += tex.max_aniso() == GX_ANISO_4 ? 1 : 0;
+    s.texels += static_cast<uint64_t>(tex.width()) * tex.height();
+    if (tex.data != nullptr && gx::g_gxState.copyTextures.contains(tex.data)) {
+      ++s.copyReads;
+    }
+  }
+  s.pipelines.insert(pipeline);
+
+  // On the split frame, each draw of the terrain lists (names containing
+  // "BG") gets its own pass, so the GPU timers time it alone. The label says
+  // what the draw is: k = alpha test (discard), b = blend, z = depth write,
+  // f = fog, l = lit; tev stages; textures and the first one's size; cull
+  // mode (0 none, 1 front, 2 back, 3 all).
+  ++sDrawInGroup;
+  if (sSplitFrame && std::strstr(current_group(), "BG") != nullptr) {
+    uint32_t texW = 0;
+    uint32_t texH = 0;
+    uint32_t texCount = 0;
+    for (uint32_t i = 0; i < gx::MaxTextures; ++i) {
+      if (info.sampledTextures.test(i)) {
+        if (texCount == 0) {
+          texW = gx::g_gxState.loadedTextures[i].width();
+          texH = gx::g_gxState.loadedTextures[i].height();
+        }
+        ++texCount;
+      }
+    }
+    const std::string label =
+        fmt::format("{} #{} v{} i{} {}{}{}{}{} tev{} tex{} {}x{} cull{}", current_group(), sDrawInGroup,
+                    static_cast<uint64_t>(vtxCount) * instanceCount, indexCount, shader.alphaCompare ? "k" : "-",
+                    config.blendMode != GX_BM_NONE ? "b" : "-", config.depthUpdate ? "z" : "-",
+                    info.usesFog ? "f" : "-", info.lightingEnabled ? "l" : "-", shader.tevStageCount, texCount, texW,
+                    texH, static_cast<int>(config.cullMode));
+    split(label.c_str());
+  }
+}
+
+void on_merged_draw(uint32_t vtxCount, uint32_t indexCount) noexcept {
+  if (sLastStats == nullptr) {
+    return;
+  }
+  ++sLastStats->mergedDraws;
+  sLastStats->verts += vtxCount;
+  sLastStats->indices += indexCount;
+}
+
+void add_fifo_ns(uint64_t ns) noexcept { sFifoNs.fetch_add(ns, std::memory_order_relaxed); }
+
+
+void frame_begin() noexcept {
+  sSplitFrame = sFrameCounter % WindowFrames == SplitFrameInWindow;
+  sSplitsThisFrame = 0;
+  if (!sGroupStack.empty()) {
+    Log.warn("[perfdiag] {} list(s) still open at frame start (innermost {}); clearing", sGroupStack.size(),
+             sGroupStack.back());
+    sGroupStack.clear();
+  }
+}
+
+void frame_end(uint64_t vertBytes, uint64_t uniformBytes, uint64_t indexBytes, uint64_t storageBytes,
+               uint64_t textureUploadBytes, uint32_t drawCalls, uint32_t mergedDrawCalls,
+               uint32_t renderPasses) noexcept {
+  if (sSplitFrame) {
+    Log.info("[perfdiag] split frame {}, anisotropic filtering {}: eye pass split {} times (GPU times: next "
+             "[gpuprof-split] line)",
+             sFrameCounter, filtering_name(), sSplitsThisFrame);
+  }
+  sSplitFrame = false;
+  sLastStats = nullptr;
+  ++sFrameCounter;
+  ++sFrames;
+  sVertBytes += vertBytes;
+  sUniformBytes += uniformBytes;
+  sIndexBytes += indexBytes;
+  sStorageBytes += storageBytes;
+  sTextureUploadBytes += textureUploadBytes;
+  sDrawCalls += drawCalls;
+  sMergedDrawCalls += mergedDrawCalls;
+  sRenderPasses += renderPasses;
+  if (sFrames < WindowFrames) {
+    return;
+  }
+  log_summary();
+  sStats.clear();
+  sFrames = 0;
+  sVertBytes = sUniformBytes = sIndexBytes = sStorageBytes = sTextureUploadBytes = 0;
+  sDrawCalls = sMergedDrawCalls = sRenderPasses = 0;
+}
+} // namespace aurora::perf_diag

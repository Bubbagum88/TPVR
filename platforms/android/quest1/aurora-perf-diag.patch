+void log_split_frame(const Slot& slot, const uint64_t* ts, uint64_t frameBegin, uint64_t frameEnd) {
+  bool split = false;
+  for (const auto& event : slot.events) {
+    if (event.kind != EventKind::End && event.name != nullptr && event.name[0] == '@') {
+      split = true;
+      break;
+    }

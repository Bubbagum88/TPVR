+  }
+  std::string out = fmt::format("[gpuprof-split] GPU frame {:.2f} ms, passes in order:",
+                                double(frameEnd - frameBegin) * 1e-6);
+  uint32_t depth = 0;
+  const char* topName = nullptr;
+  uint64_t topBegin = 0;
+  for (const auto& event : slot.events) {
+    if (event.kind == EventKind::End) {
+      if (depth == 0) {
+        continue;
+      }
+      if (--depth == 0 && topName != nullptr) {
+        const uint64_t t = ts[event.query];
+        out += fmt::format(" | {} {:.2f}ms", topName, t > topBegin ? double(t - topBegin) * 1e-6 : 0.0);
+        topName = nullptr;
+      }
+    } else {
+      if (ts[event.query] == 0 && ts[event.query + 1] == 0) {
+        continue;
+      }
+      if (depth++ == 0) {
+        topName = event.name;
+        topBegin = ts[event.query];
+      }
+    }
+  }
+  Log.info("{}", out);

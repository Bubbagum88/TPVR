+// TEMP DIAGNOSTIC (TPVR Quest 1 rendering cost, 2026-11-19): in gameplay the
+// RmlUi passes cost about 4 ms of GPU a frame, so something is drawn. Logs,
+// each time it changes, every shown document and its visible elements (tag,
+// id, classes, size, and whether it has a filter or backdrop filter).
+static void describe_visible(Rml::Element* element, std::string& out, int& budget, int depth) noexcept {
+  if (budget <= 0 || element == nullptr || !element->IsVisible()) {
+    return;
+  }
+  const auto size = element->GetBox().GetSize(Rml::BoxArea::Border);
+  if (size.x > 0.f && size.y > 0.f) {
+    --budget;
+    const bool hasFilter = element->GetProperty(Rml::PropertyId::Filter) != nullptr &&
+                           !element->GetProperty(Rml::PropertyId::Filter)->ToString().empty() &&
+                           element->GetProperty(Rml::PropertyId::Filter)->ToString() != "none";
+    const bool hasBackdrop = element->GetProperty(Rml::PropertyId::BackdropFilter) != nullptr &&
+                             !element->GetProperty(Rml::PropertyId::BackdropFilter)->ToString().empty() &&
+                             element->GetProperty(Rml::PropertyId::BackdropFilter)->ToString() != "none";
+    out += fmt::format(" {}{}{}{}{} {:.0f}x{:.0f}{}{};", std::string(static_cast<size_t>(depth), '>'),
+                       element->GetTagName(), element->GetId().empty() ? "" : "#", element->GetId(),
+                       element->GetClassNames().empty() ? "" : "." + element->GetClassNames(), size.x, size.y,
+                       hasFilter ? " filter" : "", hasBackdrop ? " backdrop" : "");
+  }
+  for (int i = 0; i < element->GetNumChildren(); ++i) {
+    describe_visible(element->GetChild(i), out, budget, depth + 1);
+  }
+}
+
+static void log_visible_documents(bool rendered) noexcept {
+  static std::string s_last;
+  std::string out = fmt::format("[uidiag] rendered {} | documents {}:", rendered ? 1 : 0,
+                                g_context->GetNumDocuments());
+  for (int i = 0; i < g_context->GetNumDocuments(); ++i) {
+    auto* doc = g_context->GetDocument(i);
+    if (doc == nullptr || !doc->IsVisible()) {
+      continue;
+    }
+    out += fmt::format(" || document '{}' '{}':", doc->GetSourceURL(), doc->GetTitle());
+    int budget = 40;
+    describe_visible(doc, out, budget, 0);
+  }
+  if (out != s_last) {
+    s_last = out;
+    Log.info("{}", out);
+  }
+}

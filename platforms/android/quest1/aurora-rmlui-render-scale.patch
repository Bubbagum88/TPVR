+// The presentation size scaled by s_renderScale: the size the context lays out
+// in and the render target is drawn at.
+Rml::Vector2i render_dimensions(Rml::Vector2i dimensions) noexcept {
+  return {
+      std::max(1, static_cast<int>(std::lround(static_cast<float>(dimensions.x) * s_renderScale))),
+      std::max(1, static_cast<int>(std::lround(static_cast<float>(dimensions.y) * s_renderScale))),
+  };
+}
+
+// Takes the presentation size. The pixel ratio is scaled with the dimensions,
+// so the layout in density-independent pixels stays the same at any render
+// scale: only the number of pixels drawn changes.
+void sync_context_metrics(Rml::Vector2i presentationDimensions) noexcept {
+  if (g_context == nullptr || presentationDimensions.x <= 0 || presentationDimensions.y <= 0) {
     return;
   }
+  const Rml::Vector2i dimensions = render_dimensions(presentationDimensions);

+// Quest 1 diagnostic: the first bytes this frame wrote to each upload area,
+// as the CPU wrote them, so the copies on the GPU can be compared with them.
+static UploadSnapshot g_uploadSnapshot;
+static void snapshot_upload(const ByteBuffer& buf, UploadSnapshot::Area& out) {
+  out.size = static_cast<uint32_t>(std::min<size_t>(buf.size(), UploadSnapshot::Bytes));
+  if (out.size != 0) {
+    std::memcpy(out.bytes, buf.data(), out.size);
+  }
+}
+const UploadSnapshot& last_upload_snapshot() noexcept { return g_uploadSnapshot; }

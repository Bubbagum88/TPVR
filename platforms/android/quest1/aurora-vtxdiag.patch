+void vtxprobe_request(VtxProbeRequest&& request) noexcept {
+  std::lock_guard lock{s_probeMutex};
+  s_probePending.emplace(request.id, std::move(request));
+}
+
+void vtxprobe_poll() noexcept {
+  const int state = s_probeState.load(std::memory_order_acquire);
+  if (state == PS_COPIED) {
+    if (++s_probePasses < kProbeMapAfterPasses) {
+      return;
+    }
+    s_probeState.store(PS_MAPPING, std::memory_order_release);
+    s_probePasses = 0;
+    s_probeReadback.MapAsync(wgpu::MapMode::Read, 0, s_probeReadback.GetSize(), wgpu::CallbackMode::AllowSpontaneous,
+                             [](wgpu::MapAsyncStatus status, wgpu::StringView message) {
+                               if (status != wgpu::MapAsyncStatus::Success) {
+                                 Log.error("[vtxprobe] readback map failed: status {} {}", static_cast<int>(status),
+                                           std::string_view(message.data, message.length));
+                               }
+                               s_probeState.store(status == wgpu::MapAsyncStatus::Success ? PS_MAPPED : PS_FAILED,
+                                                  std::memory_order_release);
+                             });
+  } else if (state == PS_MAPPING) {
+    if (++s_probePasses == kProbeGiveUpPasses) {
+      Log.error("[vtxprobe] round {}: readback never completed after {} passes", s_probeRound, kProbeGiveUpPasses);
+    }
+  } else if (state == PS_MAPPED) {
+    probe_report();
+    s_probeReadback.Unmap();
+    probe_finish_round(PS_ACCEPTING);
+  } else if (state == PS_FAILED) {
+    probe_finish_round(PS_ACCEPTING);
+  }
+}
+
+void vtxprobe_after_pass(const wgpu::CommandEncoder& cmd) noexcept {
+  if (s_probeCaptured.empty()) {
+    return;
+  }
+  auto captured = std::move(s_probeCaptured);
+  s_probeCaptured.clear();
+  if (s_probeState.load(std::memory_order_acquire) != PS_ACCEPTING) {
+    return;
+  }
+
+  // One shader per draw, from the draw's own config with the probe outputs,
+  // and one pipeline per buffer declaration.
+  probe_make_variants();
+  // The real abuf's last word, which the game's data never reaches, gets the
+  // probe pattern, so a direct read of it shows whether the shader reads the
+  // memory the copies write. Queue writes land before the next submit.
+  {
+    const uint32_t last = kProbeRawWords.back();
+    const uint32_t marker = probe_pattern(last);
+    webgpu::g_queue.WriteBuffer(gfx::detail::resources().storageBuffer, uint64_t(last) * 4u, &marker, 4);
+  }
+  std::vector<wgpu::RenderPipeline> pipelines;
+  std::vector<ProbeCaptured> rows;
+  uint32_t draws = 0;
+  for (auto& c : captured) {
+    if (draws >= kProbeMaxDraws) {
+      break;
+    }
+    if (c.data.instanceCount != 1) {
+      s_probeSkipped.push_back(fmt::format("{}: instanced (lines/points) draws are not probed", c.request.label));
+      continue;
+    }
+    g_buildVtxProbe = true;
+    const auto source = build_shader_source(c.request.config.shaderConfig);
+    g_buildVtxProbe = false;
+    if (source.empty()) {
+      s_probeSkipped.push_back(fmt::format("{}: no spare inter-stage locations for the probe outputs", c.request.label));
+      continue;
+    }
+    wgpu::ShaderSourceWGSL wgsl{};
+    wgsl.code = source.c_str();
+    const auto label = fmt::format("vtxprobe {}", c.request.id);
+    const wgpu::ShaderModuleDescriptor moduleDesc{.nextInChain = &wgsl, .label = label.c_str()};
+    // Any device error is fatal in Aurora, so the probe's own shader and
+    // pipelines are made inside error scopes: a probe that the driver
+    // refuses is reported and skipped, never used and never fatal.
+    auto& device = webgpu::g_device;
+    device.PushErrorScope(wgpu::ErrorFilter::OutOfMemory);
+    device.PushErrorScope(wgpu::ErrorFilter::Internal);
+    device.PushErrorScope(wgpu::ErrorFilter::Validation);
+    const auto module = device.CreateShaderModule(&moduleDesc);
+    std::array<wgpu::RenderPipeline, kProbeVariants.size()> variantPipelines;
+    for (size_t v = 0; v < kProbeVariants.size(); ++v) {
+      variantPipelines[v] = build_vtxprobe_pipeline(module, label.c_str(), s_probeLayouts[v]);
+    }
+    std::string errors;
+    bool allPopped = true;
+    for (const char* filter : {"validation", "internal", "out of memory"}) {
+      bool popped = false;
+      const auto future = device.PopErrorScope(
+          wgpu::CallbackMode::WaitAnyOnly,
+          [&](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView message) {
+            popped = status == wgpu::PopErrorScopeStatus::Success;
+            if (popped && type != wgpu::ErrorType::NoError) {
+              errors += fmt::format(" [{} error: {}]", filter, std::string_view(message.data, message.length));
+            }
+          });
+      if (webgpu::g_instance.WaitAny(future, 1000000000) != wgpu::WaitStatus::Success || !popped) {
+        allPopped = false;
+      }
+    }
+    if (!allPopped || !errors.empty()) {
+      s_probeSkipped.push_back(fmt::format("{}: the probe's shader/pipelines were refused{}{}", c.request.label,
+                                           allPopped ? "" : " [error scope result never arrived]", errors));
+      continue;
+    }
+    ++draws;
+    for (uint32_t v = 0; v < kProbeVariants.size(); ++v) {
+      pipelines.push_back(variantPipelines[v]);
+      rows.push_back({c.request, c.data, v});
+    }
+  }
+  if (rows.empty()) {
+    Log.warn("[vtxprobe] round {}: none of {} picked draws could be probed", s_probeRound, captured.size());
+    for (const auto& note : s_probeSkipped) {
+      Log.warn("[vtxprobe]   skipped: {}", note);
+    }
+    probe_finish_round(PS_ACCEPTING);
+    return;
+  }
+
+  s_probeRows = static_cast<uint32_t>(rows.size());
+  const wgpu::TextureDescriptor texDesc{
+      .label = "vtxprobe target",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::CopySrc,
+      .size = {VtxProbeWidth, s_probeRows, 1},
+      .format = wgpu::TextureFormat::RGBA32Uint,
+  };
+  std::array<wgpu::Texture, 2> targets{webgpu::g_device.CreateTexture(&texDesc),
+                                       webgpu::g_device.CreateTexture(&texDesc)};
+  // Unwritten pixels read back as all-ones, which no real vertex produces in
+  // every lane, so "the vertex never reached its pixel" can't pass as data.
+  constexpr double kMarker = 4294967295.0;
+  std::array<wgpu::RenderPassColorAttachment, 2> attachments{};
+  for (size_t i = 0; i < targets.size(); ++i) {
+    attachments[i] = {
+        .view = targets[i].CreateView(),
+        .loadOp = wgpu::LoadOp::Clear,
+        .storeOp = wgpu::StoreOp::Store,
+        .clearValue = {kMarker, kMarker, kMarker, kMarker},
+    };
+  }
+  const wgpu::RenderPassDescriptor passDesc{
+      .label = "vtxprobe pass",
+      .colorAttachmentCount = attachments.size(),
+      .colorAttachments = attachments.data(),
+  };
+  const auto& resources = gfx::detail::resources();
+  auto pass = cmd.BeginRenderPass(&passDesc);
+  for (uint32_t row = 0; row < s_probeRows; ++row) {
+    const auto& data = rows[row].data;
+    pass.SetPipeline(pipelines[row]);
+    pass.SetBindGroup(0, s_probeBindGroups[rows[row].variant]);
+    pass.SetViewport(0.f, static_cast<float>(row), static_cast<float>(VtxProbeWidth), 1.f, 0.f, 1.f);
+    DrawImmediateData immediates = data.immediateData;
+    immediates.stereoEye = 0;
+    pass.SetImmediates(0, &immediates, sizeof(immediates));
+    const std::array offsets{data.uniformRange.offset};
+    pass.SetBindGroup(1, resources.uniformBindGroup, offsets.size(), offsets.data());
+    pass.SetBindGroup(2, data.bindGroups.textureBindGroup ? gfx::find_bind_group(data.bindGroups.textureBindGroup)
+                                                          : g_emptyTextureBindGroup);
+    if (data.indexCount == 0) {
+      pass.Draw(data.vtxCount, 1);
+    } else {
+      pass.SetIndexBuffer(resources.indexBuffer, wgpu::IndexFormat::Uint16, data.idxRange.offset, data.idxRange.size);
+      pass.DrawIndexed(data.indexCount, 1);
+    }
+  }
+  pass.End();
+
+  const wgpu::BufferDescriptor bufDesc{
+      .label = "vtxprobe readback",
+      .usage = wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::MapRead,
+      .size = uint64_t(kProbeRowBytes) * s_probeRows * 2u,
+  };
+  s_probeReadback = webgpu::g_device.CreateBuffer(&bufDesc);
+  for (uint32_t i = 0; i < 2; ++i) {
+    const wgpu::TexelCopyTextureInfo src{.texture = targets[i]};
+    const wgpu::TexelCopyBufferInfo dst{
+        .layout = {.offset = uint64_t(kProbeRowBytes) * s_probeRows * i, .bytesPerRow = kProbeRowBytes,
+                   .rowsPerImage = s_probeRows},
+        .buffer = s_probeReadback,
+    };
+    const wgpu::Extent3D size{VtxProbeWidth, s_probeRows, 1};
+    cmd.CopyTextureToBuffer(&src, &dst, &size);
+  }
+  s_probeInFlight = std::move(rows);
+  s_probePasses = 0;
+  s_probeState.store(PS_COPIED, std::memory_order_release);
+  Log.info("[vtxprobe] round {}: {} draws x {} buffer declarations encoded for readback", s_probeRound,
+           s_probeInFlight.size() / kProbeVariants.size(), kProbeVariants.size());
+}

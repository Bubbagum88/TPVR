+// Render worker only.
+struct ProbeCaptured {
+  VtxProbeRequest request;
+  DrawData data;
+  uint32_t variant = 0;
+};
+
+// Each probed draw is re-run once per variant of group 0 (binding 0 and
+// binding 1), to find what makes the GPU read binding 1's length as 0:
+// abuf's usage (no Vertex flag), its size (exactly 8 MiB), its stage
+// visibility, the buffer object itself, or the binding slot.
+enum class ProbeBuf : uint8_t { Vbuf, Abuf, TestSame, TestVertex, TestPlus4 };
+struct ProbeVariant {
+  const char* name;
+  ProbeBuf slot0;
+  ProbeBuf slot1;
+  wgpu::ShaderStage slot1Stages;
+};
+constexpr auto kBothStages = wgpu::ShaderStage::Vertex | wgpu::ShaderStage::Fragment;
+constexpr std::array<ProbeVariant, 6> kProbeVariants{{
+    {"A: vbuf | abuf, as the game binds them", ProbeBuf::Vbuf, ProbeBuf::Abuf, kBothStages},
+    {"B: vbuf | new buffer, same usage and size as abuf (Storage|CopyDst, 8 MiB)", ProbeBuf::Vbuf,
+     ProbeBuf::TestSame, kBothStages},
+    {"C: vbuf | new buffer, abuf's size plus the Vertex flag (Storage|Vertex|CopyDst, 8 MiB)", ProbeBuf::Vbuf,
+     ProbeBuf::TestVertex, kBothStages},
+    {"D: vbuf | new buffer, abuf's usage, 8 MiB + 4 bytes (Storage|CopyDst)", ProbeBuf::Vbuf, ProbeBuf::TestPlus4,
+     kBothStages},
+    {"E: vbuf | abuf, binding 1 vertex-only", ProbeBuf::Vbuf, ProbeBuf::Abuf, wgpu::ShaderStage::Vertex},
+    {"F: abuf | vbuf, the two swapped between bindings 0 and 1", ProbeBuf::Abuf, ProbeBuf::Vbuf, kBothStages},
+}};
+std::array<wgpu::BindGroupLayout, kProbeVariants.size()> s_probeLayouts;
+std::array<wgpu::BindGroup, kProbeVariants.size()> s_probeBindGroups;
+// Words binding 1 is read at directly (no length check in our code), and
+// the pattern the new test buffers are filled with, so a read can be told
+// apart from a 0 or a read of the wrong memory.
+constexpr std::array<uint32_t, 3> kProbeRawWords{0u, 1048576u, 2097151u};
+constexpr uint32_t probe_pattern(uint32_t word) { return (word * 2654435761u) ^ 0xA5A5A5A5u; }
+std::array<wgpu::Buffer, 3> s_probeTestBuffers; // TestSame, TestVertex, TestPlus4
+
+const wgpu::Buffer& probe_buffer(ProbeBuf which) {
+  const auto& resources = gfx::detail::resources();
+  switch (which) {
+  case ProbeBuf::Vbuf:
+    return resources.vertexBuffer;
+  case ProbeBuf::Abuf:
+    return resources.storageBuffer;
+  case ProbeBuf::TestSame:
+    return s_probeTestBuffers[0];
+  case ProbeBuf::TestVertex:
+    return s_probeTestBuffers[1];
+  case ProbeBuf::TestPlus4:
+  default:
+    return s_probeTestBuffers[2];
+  }
+}
+
+bool probe_is_test(ProbeBuf which) { return which != ProbeBuf::Vbuf && which != ProbeBuf::Abuf; }
+
+const char* probe_buffer_name(ProbeBuf which) {
+  switch (which) {
+  case ProbeBuf::Vbuf:
+    return "vbuf";
+  case ProbeBuf::Abuf:
+    return "abuf";
+  default:
+    return "new test buffer";
+  }
+}
+
+void probe_make_variants() {
+  if (s_probeLayouts[0]) {
+    return;
+  }
+  struct TestDesc {
+    const char* label;
+    wgpu::BufferUsage usage;
+    uint64_t size;
+  };
+  const std::array<TestDesc, 3> tests{{
+      {"vtxprobe test: abuf's usage and size", wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopyDst,
+       gfx::StorageBufferSize},
+      {"vtxprobe test: abuf's size + Vertex",
+       wgpu::BufferUsage::Storage | wgpu::BufferUsage::Vertex | wgpu::BufferUsage::CopyDst, gfx::StorageBufferSize},
+      {"vtxprobe test: abuf's usage, 8 MiB + 4", wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopyDst,
+       gfx::StorageBufferSize + 4u},
+  }};
+  for (size_t i = 0; i < tests.size(); ++i) {
+    const wgpu::BufferDescriptor desc{.label = tests[i].label, .usage = tests[i].usage, .size = tests[i].size};
+    s_probeTestBuffers[i] = webgpu::g_device.CreateBuffer(&desc);
+    std::vector<uint32_t> words(tests[i].size / 4u);
+    for (uint32_t w = 0; w < words.size(); ++w) {
+      words[w] = probe_pattern(w);
+    }
+    webgpu::g_queue.WriteBuffer(s_probeTestBuffers[i], 0, words.data(), tests[i].size);
+    Log.info("[vtxprobe] test buffer {}: {} bytes, usage 0x{:x}, filled with the probe pattern", tests[i].label,
+             tests[i].size, static_cast<uint64_t>(tests[i].usage));
+  }
+  for (size_t i = 0; i < kProbeVariants.size(); ++i) {
+    const std::array entries{
+        wgpu::BindGroupLayoutEntry{
+            .binding = 0,
+            .visibility = wgpu::ShaderStage::Vertex,
+            .buffer = {.type = wgpu::BufferBindingType::ReadOnlyStorage},
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 1,
+            .visibility = kProbeVariants[i].slot1Stages,
+            .buffer = {.type = wgpu::BufferBindingType::ReadOnlyStorage},
+        },
+    };
+    const wgpu::BindGroupLayoutDescriptor layoutDesc{
+        .label = "vtxprobe static layout",
+        .entryCount = entries.size(),
+        .entries = entries.data(),
+    };
+    s_probeLayouts[i] = webgpu::g_device.CreateBindGroupLayout(&layoutDesc);
+    const std::array groupEntries{
+        wgpu::BindGroupEntry{.binding = 0, .buffer = probe_buffer(kProbeVariants[i].slot0)},
+        wgpu::BindGroupEntry{.binding = 1, .buffer = probe_buffer(kProbeVariants[i].slot1)},
+    };
+    const wgpu::BindGroupDescriptor groupDesc{
+        .label = "vtxprobe static bind group",
+        .layout = s_probeLayouts[i],
+        .entryCount = groupEntries.size(),
+        .entries = groupEntries.data(),
+    };
+    s_probeBindGroups[i] = webgpu::g_device.CreateBindGroup(&groupDesc);
+  }
+}
+std::vector<ProbeCaptured> s_probeCaptured; // draws of the pass being encoded
+std::vector<ProbeCaptured> s_probeInFlight; // draws in the copy being read back
+std::vector<std::string> s_probeSkipped;
+wgpu::Buffer s_probeReadback;
+uint32_t s_probeRows = 0;
+uint32_t s_probePasses = 0;
+uint32_t s_probeRound = 0;
+
+void probe_capture(const DrawData& data) {
+  if (gfx::detail::current_stereo_eye() != 0) {
+    return; // a stereo pass encodes each draw twice; the left eye's is enough
+  }
+  VtxProbeRequest request;
+  {
+    std::lock_guard lock{s_probeMutex};
+    const auto it = s_probePending.find(data.probeId);
+    if (it == s_probePending.end()) {
+      return;
+    }
+    request = std::move(it->second);
+    s_probePending.erase(it);
+  }
+  s_probeCaptured.push_back({std::move(request), data});
+}
+
+uint64_t probe_buffer_bytes(ProbeBuf which) {
+  switch (which) {
+  case ProbeBuf::Vbuf:
+    return gfx::VertexBufferSize;
+  case ProbeBuf::TestPlus4:
+    return gfx::StorageBufferSize + 4u;
+  default:
+    return gfx::StorageBufferSize;
+  }
+}
+
+// What one binding's arrayLength() should be: the bound size in u32 words.
+std::string probe_length(uint32_t binding, ProbeBuf which, uint32_t gpu, bool& ok) {
+  const uint64_t expected = probe_buffer_bytes(which) / 4u;
+  ok = gpu == expected;
+  return fmt::format("binding {} ({}): {} words, expected {}{}", binding, probe_buffer_name(which), gpu, expected,
+                     ok ? " OK" : gpu == 0 ? " ERROR: 0, every read returns 0" : " ERROR: wrong length");
+}
+
+// Binding 1 read directly at kProbeRawWords. The new test buffers hold
+// probe_pattern() everywhere; the real abuf gets it in its last word, which
+// the game's data never reaches (written before every round, see
+// vtxprobe_after_pass). vbuf (variant F) holds game data, so its words are
+// only shown.
+std::string probe_raw(ProbeBuf which, const std::array<uint32_t, 3>& got, uint32_t& checked, uint32_t& good) {
+  std::string out;
+  for (size_t i = 0; i < kProbeRawWords.size(); ++i) {
+    const uint32_t word = kProbeRawWords[i];
+    const bool known = probe_is_test(which) || (which == ProbeBuf::Abuf && word == kProbeRawWords.back());
+    out += fmt::format(" [{}]={:08x}", word, got[i]);
+    if (known) {
+      const bool same = got[i] == probe_pattern(word);
+      ++checked;
+      good += same ? 1u : 0u;
+      out += same ? " (written value, OK)" : fmt::format(" (ERROR: written {:08x})", probe_pattern(word));
+    }
+  }
+  return out;
+}
+
+bool probe_close(float cpu, float gpu) {
+  if (!std::isfinite(gpu)) {
+    return false;
+  }
+  return std::fabs(cpu - gpu) <= 1e-3f * std::max(1.f, std::fabs(cpu));
+}
+
+struct ProbeVariantTally {
+  uint32_t rows = 0, len0Ok = 0, len1Ok = 0, rawChecked = 0, rawGood = 0;
+  uint32_t len0 = 0, len1 = 0;
+};
+
+void probe_report() {
+  const auto* bytes = static_cast<const uint8_t*>(s_probeReadback.GetConstMappedRange(0, s_probeReadback.GetSize()));
+  if (bytes == nullptr) {
+    Log.error("[vtxprobe] round {}: the readback buffer mapped but GetConstMappedRange returned null", s_probeRound);
+    return;
+  }
+  const size_t planeBytes = size_t(kProbeRowBytes) * s_probeRows;
+  Log.info("[vtxprobe] round {}: {} draws re-run through their own shader with probe outputs (left eye), once per "
+           "variant of bindings 0 and 1",
+           s_probeRound, s_probeInFlight.size() / kProbeVariants.size());
+  for (const auto& note : s_probeSkipped) {
+    Log.warn("[vtxprobe]   skipped: {}", note);
+  }
+  std::array<ProbeVariantTally, kProbeVariants.size()> tally{};
+  for (uint32_t row = 0; row < s_probeInFlight.size(); ++row) {
+    const auto& req = s_probeInFlight[row].request;
+    const uint32_t variant = s_probeInFlight[row].variant;
+    const auto& pv = kProbeVariants[variant];
+    // Positions are compared only where binding 0 is vbuf and binding 1 is
+    // the real abuf, i.e. where the shader reads the game's data.
+    const bool comparePos = pv.slot0 == ProbeBuf::Vbuf && pv.slot1 == ProbeBuf::Abuf;
+    if (variant == 0) {
+      Log.info("[vtxprobe] draw {}: {}", row / kProbeVariants.size(), req.label);
+    }
+    Log.info("[vtxprobe]  variant {}", pv.name);
+    uint32_t written = 0, notWritten = 0, posOk = 0, posBad = 0, lines = 0;
+    bool lensLogged = false;
+    for (const auto& v : req.verts) {
+      if (v.vidx >= VtxProbeWidth) {
+        continue;
+      }
+      std::array<uint32_t, 4> a{}, b{};
+      std::memcpy(a.data(), bytes + size_t(row) * kProbeRowBytes + size_t(v.vidx) * 16u, 16);
+      std::memcpy(b.data(), bytes + planeBytes + size_t(row) * kProbeRowBytes + size_t(v.vidx) * 16u, 16);
+      if (a[0] == 0xFFFFFFFFu && a[1] == 0xFFFFFFFFu && a[2] == 0xFFFFFFFFu && a[3] == 0xFFFFFFFFu) {
+        ++notWritten;
+        if (lines < kProbeLinesPerDraw) {
+          ++lines;
+          Log.error("[vtxprobe]   vertex {}: ERROR the GPU never wrote this vertex's pixel (vertex shader did not "
+                    "run for it, or its point was dropped)", v.vidx);
+        }
+        continue;
+      }
+      ++written;
+      if (!lensLogged) {
+        lensLogged = true;
+        bool ok0 = false, ok1 = false;
+        Log.info("[vtxprobe]   arrayLength on the GPU: {}", probe_length(0, pv.slot0, a[3], ok0));
+        Log.info("[vtxprobe]   arrayLength on the GPU: {}", probe_length(1, pv.slot1, b[0], ok1));
+        auto& t = tally[variant];
+        ++t.rows;
+        t.len0Ok += ok0 ? 1u : 0u;
+        t.len1Ok += ok1 ? 1u : 0u;
+        t.len0 = a[3];
+        t.len1 = b[0];
+        Log.info("[vtxprobe]   binding 1 read directly:{}",
+                 probe_raw(pv.slot1, {b[1], b[2], b[3]}, t.rawChecked, t.rawGood));
+      }
+      if (!comparePos) {
+        continue;
+      }
+      std::array<float, 3> gpuPos{};
+      std::memcpy(gpuPos.data(), a.data(), 12);
+      if (!v.decoded) {
+        continue;
+      }
+      const bool pOk = probe_close(v.pos[0], gpuPos[0]) && probe_close(v.pos[1], gpuPos[1]) &&
+                       probe_close(v.pos[2], gpuPos[2]);
+      posOk += pOk ? 1u : 0u;
+      posBad += pOk ? 0u : 1u;
+      if (lines < kProbeLinesPerDraw && (!pOk || lines < 2)) {
+        ++lines;
+        Log.info("[vtxprobe]   vertex {}: pos CPU ({},{},{}) GPU ({},{},{}) bits [{:08x} {:08x} {:08x}] {}", v.vidx,
+                 v.pos[0], v.pos[1], v.pos[2], gpuPos[0], gpuPos[1], gpuPos[2], a[0], a[1], a[2],
+                 pOk ? "same" : "DIFFERENT");
+      }
+    }
+    if (comparePos) {
+      Log.info("[vtxprobe]   summary: {} vertices written, {} not written | position same {} different {}{}", written,
+               notWritten, posOk, posBad, notWritten != 0 || posBad != 0 || written == 0 ? "  ERROR" : "  (GPU matches CPU)");
+    } else {
+      Log.info("[vtxprobe]   summary: {} vertices written, {} not written (positions not compared: the bindings "
+               "don't hold the game's data as it expects)",
+               written, notWritten);
+    }
+  }
+  Log.info("[vtxprobe] round {} by variant (draws: length right at binding 0 / binding 1, direct reads right):",
+           s_probeRound);

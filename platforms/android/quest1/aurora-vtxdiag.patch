+void probe_finish_round(ProbeState next) {
+  s_probeInFlight.clear();
+  s_probeSkipped.clear();
+  s_probeReadback = {};
+  s_probeRows = 0;
+  ++s_probeRound;
+  s_probeState.store(s_probeRound >= kProbeRounds ? PS_DONE : next, std::memory_order_release);

+
+bool vtxprobe_accepting() noexcept { return s_probeState.load(std::memory_order_acquire) == PS_ACCEPTING; }
+
+uint32_t vtxprobe_next_id() noexcept { return s_probeNextId.fetch_add(1, std::memory_order_relaxed); }

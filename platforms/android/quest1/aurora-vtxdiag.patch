+      const u8* posSrc = nullptr;
+      bool posLe = false;
+      // Every indexed attribute: is the index inside its array?
+      for (u32 a = GX_VA_POS; a <= GX_VA_TEX7; ++a) {
+        const auto& m = sc.attrs[a];
+        if (m.attrType != GX_INDEX8 && m.attrType != GX_INDEX16) {
+          continue;
+        }
+        const auto& arr = state.arrays[a];
+        if (arr.data == nullptr) {
+          continue;
+        }
+        const u32 nIdx = (a == GX_VA_NRM && m.nbt3) ? 3u : 1u;
+        const u32 idxSize = m.attrType == GX_INDEX8 ? 1u : 2u;
+        for (u32 j = 0; j < nIdx; ++j) {
+          const u8* ip = rec + m.offset + j * idxSize;
+          const u32 idx = m.attrType == GX_INDEX8 ? ip[0] : u32((ip[0] << 8) | ip[1]); // stream is big-endian
+          const u64 end = u64(idx) * m.stride + attr_extent(a, m);
+          if (end > arr.size) {
+            report(K_INDEX_PAST_ARRAY, draw, "vertex {} {} index {} x stride {} + {} = {} > array size {}", v,
+                   attr_name(a), idx, m.stride, attr_extent(a, m), end, arr.size);
+          } else if (a == GX_VA_POS) {
+            posSrc = static_cast<const u8*>(arr.data) + u64(idx) * m.stride;
+            posLe = m.le;
+          }
+        }
+      }
+      if (pos.attrType == GX_DIRECT) {
+        posSrc = rec + pos.offset; // vertex stream: always big-endian
+        posLe = false;
+      }
+      u32 pnIdx = imm.currentPnMtx;
+      if (directPnMtx) {
+        pnIdx = rec[sc.attrs[GX_VA_PNMTXIDX].offset] / 3u;
+      }
+      if (posSrc == nullptr || pos.cnt < 2 || pos.cnt > 3) {
+        continue;
+      }
+      ++decodedVerts;
+      const u32 cs = comp_type_size(GX_VA_POS, static_cast<GXCompType>(pos.compType));
+      float p[3] = {0.f, 0.f, 0.f};
+      float alt[3] = {0.f, 0.f, 0.f};
+      for (u32 c = 0; c < pos.cnt; ++c) {
+        p[c] = read_comp(posSrc + c * cs, pos.compType, pos.frac, posLe);
+        alt[c] = read_comp(posSrc + c * cs, pos.compType, pos.frac, !posLe);
+      }
+      if (v == 0) {
+        std::memcpy(firstPos, p, sizeof(p));
+        firstPn = pnIdx;
+      }
+      if (p[0] == 0.f && p[1] == 0.f && p[2] == 0.f) {
+        ++zeroVerts;
+      }
+      if (any_junk(p, pos.cnt)) {
+        ++junkVerts;
+        if (pos.compType == GX_F32 && !any_junk(alt, pos.cnt)) {
+          report(K_POS_BYTE_ORDER, draw, "vertex {} declared le={} reads ({},{},{}) bytes [{}]; other order reads "
+                 "({},{},{})", v, posLe, p[0], p[1], p[2], hex_bytes(posSrc, pos.cnt * cs), alt[0], alt[1], alt[2]);
+        } else {
+          report(K_POS_JUNK, draw, "vertex {} le={} reads ({},{},{}) bytes [{}]", v, posLe, p[0], p[1], p[2],
+                 hex_bytes(posSrc, pos.cnt * cs));
+        }
+        continue;
+      }
+      if (pnIdx >= MaxPnMtx) {
+        check_pn_matrix(pnIdx, draw);
+        continue;
+      }
+      if (!pnChecked[pnIdx]) {
+        pnChecked[pnIdx] = true;
+        if (directPnMtx) {
+          check_pn_matrix(pnIdx, draw);
+        }
+      }
+      bool inside = false;
+      bool behind = true;
+      for (u32 eye = 0; eye < eyes; ++eye) {
+        float clip[4];
+        project(sc, state.pnMtx[pnIdx].pos, p, eye, clip);
+        if (v == 0 && eye == 0) {
+          std::memcpy(firstClip, clip, sizeof(clip));
+        }
+        inside = inside || clip_inside(clip);
+        behind = behind && !(clip[3] > 0.f);
+      }
+      insideVerts += inside ? 1u : 0u;
+      behindVerts += behind ? 1u : 0u;
+    }
+    st.frame.verts += decodedVerts;
+    st.frame.zeroVerts += zeroVerts;
+    st.frame.onScreenVerts += insideVerts;
+    if (decodedVerts != 0 && zeroVerts == decodedVerts) {
+      report(K_POS_ALL_ZERO, draw, "{} of {} positions are (0,0,0)", zeroVerts, decodedVerts);
+    }
+    const u32 sane = decodedVerts - junkVerts;
+    if (sane != 0 && behindVerts == sane) {
+      report(K_ALL_BEHIND_EYE, draw, "{} vertices, vertex 0 pos=({},{},{}) clip=({},{},{},{})", sane, firstPos[0],
+             firstPos[1], firstPos[2], firstClip[0], firstClip[1], firstClip[2], firstClip[3]);
+    } else if (sane != 0 && insideVerts == 0) {
+      report(K_ALL_OFF_SCREEN, draw, "{} vertices, vertex 0 pos=({},{},{}) pnmtx={} clip=({},{},{},{})", sane,
+             firstPos[0], firstPos[1], firstPos[2], firstPn, firstClip[0], firstClip[1], firstClip[2], firstClip[3]);
+    }
+    if (drawNo < kTraceDrawsPerDeepFrame || (stereo && st.frame.stereoDraws <= kTraceDrawsPerDeepFrame)) {
+      Log.info("[vtxdiag] trace {} | vertex 0 pos=({:.3f},{:.3f},{:.3f}) pnmtx={} clip=({:.3f},{:.3f},{:.3f},{:.3f}) | "
+               "decoded={} zero={} junk={} on-screen={} behind={} | vp=({:.0f},{:.0f} {:.0f}x{:.0f} z {:.3f}-{:.3f}) "
+               "{} | depth test={} func={} write={} | colorWrite={} alphaWrite={} blend mode={} src={} dst={} | "
+               "alphaTest {} {} {} {} {} | cull={} dstAlpha={}",
+               draw(), firstPos[0], firstPos[1], firstPos[2], firstPn, firstClip[0], firstClip[1], firstClip[2],
+               firstClip[3], decodedVerts, zeroVerts, junkVerts, insideVerts, behindVerts, vp.left, vp.top, vp.width,
+               vp.height, vp.znear, vp.zfar, perspective ? "persp" : "ortho", config.depthCompare,
+               static_cast<int>(config.depthFunc), config.depthUpdate, config.colorUpdate, config.alphaUpdate,
+               static_cast<int>(config.blendMode), static_cast<int>(config.blendFacSrc),
+               static_cast<int>(config.blendFacDst), static_cast<int>(sc.alphaCompare.comp0), sc.alphaCompare.ref0,
+               static_cast<int>(sc.alphaCompare.op), static_cast<int>(sc.alphaCompare.comp1), sc.alphaCompare.ref1,
+               static_cast<int>(config.cullMode), config.dstAlpha);
+    }
+  }
+
+  if (error_total() == errorsBefore) {
+    ++st.frame.cleanDraws;
+  }
+}

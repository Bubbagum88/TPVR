+constexpr uint32_t kProbeMaxDraws = 12;
+constexpr uint32_t kProbeRounds = 3;
+constexpr uint32_t kProbeLinesPerDraw = 8;
+// Passes encoded between the probe's copy and its MapAsync: the copy's
+// command buffer must be submitted before the buffer is mapped, and a frame
+// is about 15 passes.
+constexpr uint32_t kProbeMapAfterPasses = 200;
+constexpr uint32_t kProbeGiveUpPasses = 5000;
+constexpr uint32_t kProbeRowBytes = VtxProbeWidth * 16; // RGBA32Uint, a multiple of 256

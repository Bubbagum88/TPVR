+// ---------------------------------------------------------------------------
+// Quest 1 vertex diagnostics ([vtxdiag] in the log).
+//
+// Every GX draw is checked here before it is recorded, so a draw that can't
+// put pixels on screen says why instead of failing silently.
+//
+// Every draw (cheap): array pointers and sizes, whether the array was staged
+// for the GPU and at the offset the shader is given, the draw's vertex
+// stream against the GPU vertex buffer, the position matrix and projection
+// (zero / NaN), and pipeline state that can't write a pixel (no colour
+// write, depth NEVER, an alpha test no alpha value passes, empty viewport).
+//
+// Deep frames (the first 3 frames, the first 3 frames with stereo draws, and
+// then every 300th frame): every vertex of every draw is also decoded on the
+// CPU exactly as the GX vertex shader reads it: each index is checked
+// against its array's size, each position is checked for zero and for junk
+// (NaN, infinity, denormal, huge) and decoded in the other byte order too,
+// and each is projected to see whether it lands on screen. The bytes staged
+// for the GPU are compared with the game's own vertex stream and arrays.
+//
+// Each check that fails logs one error naming the check, the draw and the
+// values (a few per check per deep frame, the rest counted); each deep frame
+// ends with a summary line.
+namespace {
+namespace vtxdiag {
+enum Kind : u32 {
+  K_NOT_RECORDING,
+  K_ARRAY_NULL,
+  K_ARRAY_EMPTY,
+  K_ARRAY_STRIDE,
+  K_STAGE_MISSING,
+  K_STAGE_SIZE,
+  K_STAGE_OFFSET,
+  K_STAGE_PAST_GPU_BUFFER,
+  K_STAGE_MISMATCH,
+  K_STAGE_ZERO,
+  K_SRC_ZERO,
+  K_VTX_STRIDE,
+  K_VTX_SHORT,
+  K_VTX_PAST_GPU_BUFFER,
+  K_VTX_STAGE_MISMATCH,
+  K_INDEX_PAST_ARRAY,
+  K_POS_ALL_ZERO,
+  K_POS_JUNK,
+  K_POS_BYTE_ORDER,
+  K_PNMTX_RANGE,
+  K_MTX_ZERO,
+  K_MTX_JUNK,
+  K_PROJ_ZERO,
+  K_PROJ_JUNK,
+  K_ALL_BEHIND_EYE,
+  K_ALL_OFF_SCREEN,
+  K_NO_COLOR_WRITE,
+  K_ALPHA_ALWAYS_FAILS,
+  K_DEPTH_NEVER,
+  K_VIEWPORT_EMPTY,
+  K_COUNT,
+};
+
+struct KindInfo {
+  const char* name;
+  bool error; // false: worth knowing, but legitimate for some draws
+  const char* meaning;
+};
+constexpr std::array<KindInfo, K_COUNT> kKinds{{
+    {"NOT_RECORDING", true, "draw issued outside a recording frame: nothing is staged for it"},
+    {"ARRAY_NULL", true, "indexed attribute with no array set (GXSetArray never called)"},
+    {"ARRAY_EMPTY", true, "indexed attribute whose array has size 0 or stride 0"},
+    {"ARRAY_STRIDE", true, "stride in the shader differs from the array's stride"},
+    {"STAGE_MISSING", true, "array was not staged for the GPU: the shader reads whatever is at offset 0"},
+    {"STAGE_SIZE", true, "staged range size differs from the array size"},
+    {"STAGE_OFFSET", true, "array_start given to the shader differs from where the array was staged"},
+    {"STAGE_PAST_GPU_BUFFER", true, "staged array ends past the GPU storage buffer: reads there return 0"},
+    {"STAGE_MISMATCH", true, "bytes staged for the GPU differ from the game's array now (stale or overwritten)"},
+    {"STAGE_ZERO", true, "staged bytes are all zero but the game's array is not"},
+    {"SRC_ZERO", true, "the game's array itself is all zero"},
+    {"VTX_STRIDE", true, "vertex stride in the shader differs from the vertex format's size"},
+    {"VTX_SHORT", true, "vertex stream shorter than vertex count x stride: the shader reads past this draw"},
+    {"VTX_PAST_GPU_BUFFER", true, "vertex stream ends past the GPU vertex buffer: reads there return 0"},
+    {"VTX_STAGE_MISMATCH", true, "vertex bytes staged for the GPU differ from the game's vertex stream"},
+    {"INDEX_PAST_ARRAY", true, "a vertex index points past the end of its array: the read gets other data"},
+    {"POS_ALL_ZERO", true, "every position in the draw decodes to (0,0,0)"},
+    {"POS_JUNK", true, "position decodes to NaN, infinity, a denormal or a huge value"},
+    {"POS_BYTE_ORDER", true, "position is junk in the declared byte order but sane in the other one"},
+    {"PNMTX_RANGE", true, "position matrix index out of range"},
+    {"MTX_ZERO", true, "position matrix is all zero: every vertex lands on the origin"},
+    {"MTX_JUNK", true, "position matrix has NaN or infinity"},
+    {"PROJ_ZERO", true, "projection or eye view matrix is all zero"},
+    {"PROJ_JUNK", true, "projection or eye view matrix has NaN or infinity"},
+    {"ALL_BEHIND_EYE", false, "every vertex is behind the eye (w <= 0)"},
+    {"ALL_OFF_SCREEN", false, "no vertex lands inside the eye's view or depth range"},
+    {"NO_COLOR_WRITE", false, "colour and alpha writes are both off (depth-only draw)"},
+    {"ALPHA_ALWAYS_FAILS", true, "alpha test that no alpha value passes: every pixel is discarded"},
+    {"DEPTH_NEVER", true, "depth test NEVER: every pixel is rejected"},
+    {"VIEWPORT_EMPTY", true, "render viewport has zero width or height"},
+}};
+
+constexpr u32 kDeepEvery = 300;
+constexpr u32 kDeepFirst = 3;
+constexpr u32 kDetailPerKindPerFrame = 3;
+constexpr u32 kDetailPerKindCheapFrames = 5; // lifetime budget outside deep frames
+constexpr u32 kTraceDrawsPerDeepFrame = 8;
+
+struct Counts {
+  std::array<u32, K_COUNT> kind{};
+  u32 draws = 0;
+  u32 stereoDraws = 0;
+  u32 cleanDraws = 0;
+  u32 mergedDraws = 0;
+  u64 verts = 0;
+  u64 zeroVerts = 0;
+  u64 onScreenVerts = 0;
+};
+
+struct State {
+  u64 frameId = UINT64_MAX;
+  u32 framesSeen = 0;
+  u32 stereoDeepFramesDone = 0;
+  u32 framesSinceReport = 0;
+  bool deep = false;
+  bool frameHadStereo = false;
+  Counts frame;
+  Counts sinceReport;
+  std::array<u32, K_COUNT> loggedThisFrame{};
+  std::array<u32, K_COUNT> loggedCheap{};
+};
+State s_state;
+const u8* s_vertexData = nullptr; // the draw's vertex stream, set around push_gx_draw
+
+std::string counts_string(const std::array<u32, K_COUNT>& kind) {
+  std::string out;
+  for (u32 k = 0; k < K_COUNT; ++k) {
+    if (kind[k] != 0) {
+      out += fmt::format("{}{}={}", out.empty() ? "" : " ", kKinds[k].name, kind[k]);
+    }
+  }
+  return out.empty() ? "none" : out;
+}
+
+void flush_frame() {
+  auto& st = s_state;
+  if (st.frameId == UINT64_MAX) {
+    return;
+  }
+  for (u32 k = 0; k < K_COUNT; ++k) {
+    st.sinceReport.kind[k] += st.frame.kind[k];
+  }
+  st.sinceReport.draws += st.frame.draws;
+  st.sinceReport.stereoDraws += st.frame.stereoDraws;
+  st.sinceReport.cleanDraws += st.frame.cleanDraws;
+  st.sinceReport.mergedDraws += st.frame.mergedDraws;
+  ++st.framesSinceReport;
+  if (st.deep) {
+    const auto& f = st.frame;
+    Log.info("[vtxdiag] frame {} (deep) summary: draws={} stereo={} passed-all-checks={} merged-unchecked={} verts={} "
+             "zero-pos-verts={} on-screen-verts={} | findings: {}",
+             st.frameId, f.draws, f.stereoDraws, f.cleanDraws, f.mergedDraws, f.verts, f.zeroVerts, f.onScreenVerts,
+             counts_string(f.kind));
+    if (f.draws != 0 && f.cleanDraws == f.draws) {
+      Log.info("[vtxdiag] frame {}: every draw passed every CPU-side check; if the view is still blank, the fault is "
+               "after Aurora (GPU colours: see [vtxdiag-gpu])",
+               st.frameId);
+    }
+    const auto& s = st.sinceReport;
+    Log.info("[vtxdiag] since the last report ({} frames): draws={} stereo={} passed-all-checks={} | findings: {}",
+             st.framesSinceReport, s.draws, s.stereoDraws, s.cleanDraws, counts_string(s.kind));
+    st.sinceReport = {};
+    st.framesSinceReport = 0;
+    if (st.frameHadStereo && st.stereoDeepFramesDone < kDeepFirst) {
+      ++st.stereoDeepFramesDone;
+    }
+  }
+}
+
+void begin_frame_if_new(u64 frameId) {
+  auto& st = s_state;
+  if (frameId == st.frameId) {
+    return;
+  }
+  flush_frame();
+  st.frameId = frameId;
+  ++st.framesSeen;
+  st.deep = st.framesSeen <= kDeepFirst || st.framesSeen % kDeepEvery == 0;
+  st.frameHadStereo = false;
+  st.frame = {};
+  st.loggedThisFrame = {};
+  if (st.deep) {
+    Log.info("[vtxdiag] frame {} is a deep frame: checking every vertex of every draw", frameId);
+  }
+}
+
+// A draw appended to the previous one (draw_prim's merge path): same state,
+// not checked on its own.
+void note_merged() {
+  begin_frame_if_new(gfx::debug_recording_frame_id());
+  ++s_state.frame.mergedDraws;
+}
+
+// One finding. Returns true if the caller should log detail for it.
+bool note(Kind k) {
+  auto& st = s_state;
+  ++st.frame.kind[k];
+  if (st.deep) {
+    return st.loggedThisFrame[k]++ < kDetailPerKindPerFrame;
+  }
+  return st.loggedCheap[k]++ < kDetailPerKindCheapFrames;
+}
+
+// `draw` describes the draw being checked (a callable returning a string);
+// it is only called when a line is logged.
+template <typename D, typename... T>
+void report(Kind k, const D& draw, fmt::format_string<T...> f, T&&... args) {
+  if (!note(k)) {
+    return;
+  }
+  const auto detail = fmt::format(f, std::forward<T>(args)...);
+  if (kKinds[k].error) {
+    Log.error("[vtxdiag] {} ({}) | {} | {}", kKinds[k].name, kKinds[k].meaning, draw(), detail);
+  } else {
+    Log.warn("[vtxdiag] {} ({}) | {} | {}", kKinds[k].name, kKinds[k].meaning, draw(), detail);
+  }
+}

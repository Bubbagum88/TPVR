diff --git a/lib/gx/shader.cpp b/lib/gx/shader.cpp
index 69f70e6..cfa4f1f 100644
--- a/lib/gx/shader.cpp
+++ b/lib/gx/shader.cpp
@@ -1719,7 +1719,10 @@ fn load_word(p: ptr<storage, array<u32>>, word_idx: u32) -> u32 {{
   // It appears to discourage some Adreno drivers/optimizers from storage buffer
   // optimizations that can cause visual artifacts, including vertex explosions
   // in Dusklight.
-  if (word_idx < arrayLength(p)) {{
+  // Quest 1: the Adreno 540 driver crashes in vkCmdDrawIndexed when a
+  // shader uses arrayLength() on these buffers, so compare against the
+  // larger buffer's size (VertexBufferSize / 4) instead.
+  if (word_idx < 2621440u) {{
     return p[word_idx];
   }}
   return 0u;
diff --git a/lib/webgpu/gpu.cpp b/lib/webgpu/gpu.cpp
index 0da5cab..b2a38ab 100644
--- a/lib/webgpu/gpu.cpp
+++ b/lib/webgpu/gpu.cpp
@@ -1099,6 +1099,12 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
         // "skip_validation",
         // "disable_robustness",
 #endif
+#ifdef ANDROID
+        // Quest 1: Tint's robustness clamps every storage-buffer index with
+        // arrayLength(), which crashes the Adreno 540 driver in
+        // vkCmdDrawIndexed. Vulkan's robustBufferAccess still bounds reads.
+        "disable_robustness",
+#endif
 #ifndef ANDROID
         "use_user_defined_labels_in_backend",
 #endif

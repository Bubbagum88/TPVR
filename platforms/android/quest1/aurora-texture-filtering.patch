+// Set by set_max_texture_anisotropy(); 0 until then (use the startup config).
+std::atomic<u16> s_maxAnisotropy{0};
+
 u16 wgpu_aniso(GXAnisotropy aniso) {
+  const u16 maxAniso = max_texture_anisotropy();
   switch (aniso) {
     DEFAULT_FATAL("invalid aniso {}", static_cast<int>(aniso));
   case GX_ANISO_1:
   case GX_MAX_ANISOTROPY:
     return 1;
   case GX_ANISO_2:
-    return std::max<u16>(webgpu::g_graphicsConfig.textureAnisotropy / 2, 1);
+    return std::max<u16>(maxAniso / 2, 1);
   case GX_ANISO_4:
-    return std::max<u16>(webgpu::g_graphicsConfig.textureAnisotropy, 1);
+    return std::max<u16>(maxAniso, 1);
   }
 }
 } // namespace
@@ -303,6 +309,17 @@ void write_texture(TextureRef& ref, ArrayRef<uint8_t> data) noexcept {
   }
 }
 
+void set_max_texture_anisotropy(uint16_t value) noexcept {
+  s_maxAnisotropy.store(std::clamp<u16>(value, 1, 16), std::memory_order_relaxed);
+  // Cached bind groups hold samplers made with the old value.
+  gx::texture::invalidate_bindings();
+}
+
+uint16_t max_texture_anisotropy() noexcept {
+  const u16 value = s_maxAnisotropy.load(std::memory_order_relaxed);
+  return value != 0 ? value : webgpu::g_graphicsConfig.textureAnisotropy;
+}
+
 wgpu::SamplerDescriptor TextureBind::get_descriptor() const noexcept {
   auto [minFilter, mipFilter] = wgpu_filter_mode(texObj.min_filter());
   auto [magFilter, _] = wgpu_filter_mode(texObj.mag_filter());

+}
+
+// Dawn does not destroy a released surface's VkSwapchainKHR and VkSurfaceKHR
+// at once: SwapChainVk.cpp DetachFromSurfaceImpl() hands both to the fenced
+// deleter, tagged with the queue's pending serial. The VkSurfaceKHR is what
+// holds the window: Android's vkCreateAndroidSurfaceKHR connects to it and
+// vkDestroySurfaceKHR disconnects. While it lives, a new
+// vkCreateAndroidSurfaceKHR on the same window fails with
+// VK_ERROR_NATIVE_WINDOW_IN_USE_KHR, which Dawn turns into device loss (seen on
+// a Quest 1 after "Surface texture is Lost", 2026-11-04).
+//
+// The fenced deleter is registered at QueuePriority::BestEffort
+// (DeviceVk.cpp), and only DeviceBase::Tick() updates that priority
+// (UpdateCompletedSerial(QueuePriority::Lowest)). WaitAny() on a work-done
+// future updates only QueuePriority::UserVisible, and it moves the completed
+// serial up to the last submitted one, so a Tick() right after it finds no
+// scheduled commands and returns early without running the deleter.
+//
+// So: write once to put the deletion serial in a submission and wait for it;
+// then write again so the queue has a pending command, which makes Tick()
+// run UpdateCompletedSerial(Lowest) and destroy everything up to the
+// completed serial, the old swapchain and surface included.
+static void wait_for_released_surface() noexcept {
+  if (!g_surfaceReleasePending || !g_device || !g_queue) {
+    return;
+  }
+  g_surfaceReleasePending = false;
+  if (!g_surfaceReleaseFlushBuffer) {
+    const wgpu::BufferDescriptor descriptor{
+        .label = "Surface release flush buffer",
+        .usage = wgpu::BufferUsage::CopyDst,
+        .size = 4,
+    };
+    g_surfaceReleaseFlushBuffer = g_device.CreateBuffer(&descriptor);
+  }
+  const uint32_t zero = 0;
+  g_queue.WriteBuffer(g_surfaceReleaseFlushBuffer, 0, &zero, sizeof(zero));
+  wgpu::QueueWorkDoneStatus workStatus = wgpu::QueueWorkDoneStatus::CallbackCancelled;
+  const auto future = g_queue.OnSubmittedWorkDone(
+      wgpu::CallbackMode::WaitAnyOnly,
+      [&](wgpu::QueueWorkDoneStatus status, wgpu::StringView) { workStatus = status; });
+  const auto waitStatus = g_instance.WaitAny(future, 5000000000);
+  if (waitStatus != wgpu::WaitStatus::Success || workStatus != wgpu::QueueWorkDoneStatus::Success) {
+    Log.warn("Waiting for the released surface's last submission: wait status {}, work status {}",
+             magic_enum::enum_name(waitStatus), magic_enum::enum_name(workStatus));
+  }
+  g_queue.WriteBuffer(g_surfaceReleaseFlushBuffer, 0, &zero, sizeof(zero));
+  g_device.Tick();
+  Log.info("Ticked the device after the released surface's submission completed (wait status {})",
+           magic_enum::enum_name(waitStatus));
+}
 
